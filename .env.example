# Set in the shell or local Vite environment file before dev/build (main only).
# SSO frontend and backend origins; the OIDC issuer is derived as CLIENT_URL/auth.
VITE_SSO_OAUTH_CLIENT_ID=gorth-browser
VITE_SSO_CLIENT_URL=http://localhost:3000
VITE_SSO_SERVER_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5501

VITE_SSO_ACCESS_TOKEN=gorth.access_token
VITE_SSO_REFRESH_TOKEN=gorth.refresh_token
VITE_SSO_SESSION_APP=gorth.session_app
VITE_SSO_OAUTH_STATE=gorth.oauth_state
VITE_SSO_OAUTH_CODE_VERIFIER=gorth.oauth_code_verifier
VITE_SSO_OAUTH_RETURN_TO=gorth.oauth_return_to
VITE_SSO_OAUTH_ISSUER=gorth.oauth_issuer
VITE_SSO_OAUTH_NONCE=gorth.oauth_nonce
